--- /dev/null
+++ b/defenvs/an7581_gemtek_xg2010g_env
@@ -0,0 +1,24 @@
+ipaddr=192.168.0.1
+serverip=192.168.0.205
+loadaddr=0x88000000
+console=earlycon console=ttyS0,115200n8
+bootcmd=run boot_ubi
+bootconf=config-1
+bootdelay=3
+bootfile=openwrt-airoha-an7581-gemtek_xg2010g-ubi-initramfs-recovery.itb
+bootled_status=sts_green
+bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 60
+bootmenu_default=0
+bootmenu_delay=3
+bootmenu_title=      [0;34m( ( ( [1;39mOpenWrt[0;34m ) ) )
+bootmenu_0=Run default boot command.=run boot_default
+bootmenu_1=Boot recovery/initramfs via TFTP.=run boot_tftp ; run bootmenu_confirm_return
+bootmenu_2=Boot production system from UBI.=run boot_production ; run bootmenu_confirm_return
+bootmenu_3=Reboot.=reset
+boot_default=run bootcmd
+boot_ubi=ubi part ubi && run boot_production
+boot_production=led $bootled_status on ; ubi read $loadaddr fit && iminfo $loadaddr && bootm $loadaddr#$bootconf ; led $bootled_status off
+boot_tftp=tftpboot $loadaddr $bootfile && iminfo $loadaddr && bootm $loadaddr#$bootconf
+boot_tftp_forever=led $bootled_status on ; while true ; do run boot_tftp ; sleep 1 ; done
+preboot=led $bootled_status on
+check_buttons=if button reset ; then run boot_tftp ; fi
--- /dev/null
+++ b/dts/upstream/src/arm64/airoha/an7581-gemtek-xg2010g-ubi.dts
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/dts-v1/;
+
+/* Bootloader installs ATF here */
+/memreserve/ 0x80000000 0x200000;
+
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include "en7581.dtsi"
+
+/ {
+	model = "Gemtek XG2010G (UBI) chainloader";
+	compatible = "gemtek,xg2010g-ubi", "econet,xg2010g-ubi",
+		     "airoha,an7581", "airoha,en7581";
+
+	aliases {
+		serial0 = &uart1;
+	};
+
+	chosen {
+		bootargs = "console=ttyS0,115200 earlycon";
+		stdout-path = "serial0:115200n8";
+		linux,usable-memory-range = <0x0 0x80200000 0x0 0x3fe00000>;
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x40000000>;
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		button-reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_tx_power {
+			label = "tx-power";
+			gpios = <&en7581_pinctrl 38 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		led_status_red: led-status-red {
+			label = "sts_red";
+			gpios = <&en7581_pinctrl 43 GPIO_ACTIVE_LOW>;
+		};
+
+		led_status_green: led-status-green {
+			label = "sts_green";
+			gpios = <&en7581_pinctrl 44 GPIO_ACTIVE_LOW>;
+		};
+
+		led_status_blue: led-status-blue {
+			label = "sts_blue";
+			gpios = <&en7581_pinctrl 45 GPIO_ACTIVE_LOW>;
+		};
+
+		led_status_white {
+			label = "sts_white";
+			gpios = <&en7581_pinctrl 33 GPIO_ACTIVE_LOW>;
+		};
+
+		led_pon_green {
+			label = "pon_act_green";
+			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
+		};
+
+		led_pon_red {
+			label = "pon_lnk_red";
+			gpios = <&en7581_pinctrl 16 GPIO_ACTIVE_LOW>;
+		};
+
+		led_lan_green {
+			label = "lan_led_green";
+			gpios = <&en7581_pinctrl 46 GPIO_ACTIVE_LOW>;
+		};
+
+		led_lan_yellow {
+			label = "lan_led_yellow";
+			gpios = <&en7581_pinctrl 42 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
+
+&en7581_pinctrl {
+	gpio-ranges = <&en7581_pinctrl 0 13 47>;
+};
+
+&snfi {
+	status = "okay";
+};
+
+&spi_nand {
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			label = "bootloader";
+			reg = <0x00000000 0x00200000>;
+			read-only;
+		};
+
+		partition@200000 {
+			label = "uenv";
+			reg = <0x00200000 0x00200000>;
+			read-only;
+		};
+
+		partition@400000 {
+			label = "dsd";
+			reg = <0x00400000 0x00200000>;
+			read-only;
+		};
+
+		partition@600000 {
+			label = "ubi";
+			reg = <0x00600000 0x08000000>;
+		};
+
+		partition@8600000 {
+			label = "system";
+			reg = <0x08600000 0x13700000>;
+			read-only;
+		};
+
+		partition@1bd00000 {
+			label = "art";
+			reg = <0x1bd00000 0x00300000>;
+			read-only;
+		};
+	};
+};
+
+&i2c0 {
+	status = "okay";
+};
+
+&eth {
+	status = "okay";
+};
+
+&gdm1 {
+	status = "okay";
+};
