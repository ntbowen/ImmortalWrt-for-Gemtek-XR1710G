create_xg2010g_factory() {
	local board="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
	local dsd=/dev/mtdblock2
	local ubi=/dev/ubi0
	local tmp=/tmp/factory.bin
	local wan lan voldev

	[ "$board" = "gemtek,xg2010g-ubi" ] || return
	[ -e "$ubi" ] || return
	ubinfo -N factory "$ubi" >/dev/null 2>&1 && return

	wan=$(strings "$dsd" 2>/dev/null | sed -n 's/^wan_mac=//p')
	lan=$(strings "$dsd" 2>/dev/null | sed -n 's/^lan_mac=//p')
	[ -n "$wan" -a -n "$lan" ] || return

	hex2bin() {
		for b in $(echo "$1" | tr ':' ' '); do
			printf "\\$(printf '%03o' 0x$b)"
		done
	}

	dd if=/dev/zero of="$tmp" bs=1024 count=28 2>/dev/null
	hex2bin "$wan" | dd of="$tmp" bs=1 seek=20480 conv=notrunc 2>/dev/null
	hex2bin "$lan" | dd of="$tmp" bs=1 seek=24576 conv=notrunc 2>/dev/null

	ubimkvol "$ubi" -N factory -s 28672 2>/dev/null || return

	voldev=$(ubinfo -a "$ubi" 2>/dev/null | awk '
		/^Volume ID:/{id=$3}
		/Name:.*factory/{print "/dev/ubi0_" id; exit}
	')
	[ -e "$voldev" ] || return
	ubiupdatevol "$voldev" "$tmp" 2>/dev/null
	rm -f "$tmp"
}

boot_hook_add preinit_main create_xg2010g_factory
