/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/phy/phy.h>
#include "an7581.dtsi"

/ {
	model = "Gemtek XG2010G (UBI)";
	compatible = "gemtek,xg2010g-ubi", "econet,xg2010g-ubi",
		     "airoha,an7581", "airoha,en7581";

	aliases {
		serial0 = &uart1;
		led-boot = &led_status_red;
		led-failsafe = &led_status_red;
		led-upgrade = &led_status_blue;
		led-running = &led_status_green;
	};

	chosen {
		rootdisk = <&ubi_rootfs>;
		bootargs = "console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_tx_power: led-tx-power {
			label = "tx-power";
			gpios = <&en7581_pinctrl 38 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_status_red: led-status-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 43 GPIO_ACTIVE_LOW>;
		};

		led_status_green: led-status-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 44 GPIO_ACTIVE_LOW>;
		};

		led_status_blue: led-status-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 45 GPIO_ACTIVE_LOW>;
		};

		led_status_white: led-status-white {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 33 GPIO_ACTIVE_LOW>;
		};

		led_pon_green: led-pon-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
		};

		led_pon_red: led-pon-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&en7581_pinctrl 16 GPIO_ACTIVE_LOW>;
		};

		led_lan_green: led-lan-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&en7581_pinctrl 46 GPIO_ACTIVE_LOW>;
		};

		led_lan_yellow: led-lan-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_LAN;
			gpios = <&en7581_pinctrl 42 GPIO_ACTIVE_LOW>;
		};
	};

	pcm: pcm@1fbd0000 {
		compatible = "econet,ecnt-pcm";
		reg = <0x0 0x1fbd0000 0x0 0x4fff>;
		interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 47>;

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};

		conf {
			pins = "gpio2";
			output-high;
		};
	};

};

&snfi {
	status = "okay";
};

&spi_nand {
	/* Winbond W25N04KVZEIR 512 MB SPI-NAND. */
	#address-cells = <1>;
	#size-cells = <1>;
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x00000000 0x00200000>;
			read-only;
		};

		partition@200000 {
			label = "uenv";
			reg = <0x00200000 0x00200000>;
			read-only;
		};

		partition@400000 {
			label = "dsd";
			reg = <0x00400000 0x00200000>;
			read-only;
		};

		partition@600000 {
			label = "ubi";
			reg = <0x00600000 0x08000000>;
			compatible = "linux,ubi";

			volumes {
				ubi-volume-ubootenv {
					volname = "ubootenv";
					nvmem-layout {
						compatible = "u-boot,env-redundant-bool";
					};
				};

				ubi-volume-ubootenv2 {
					volname = "ubootenv2";
					nvmem-layout {
						compatible = "u-boot,env-redundant-bool";
					};
				};

				ubi_rootfs: ubi-volume-fit {
					volname = "fit";
				};

				ubi_factory: ubi-volume-factory {
					volname = "factory";
				};
			};
		};

		partition@8600000 {
			label = "system";
			reg = <0x08600000 0x13700000>;
			read-only;
		};

		partition@1bd00000 {
			label = "art";
			reg = <0x1bd00000 0x00300000>;
			read-only;
		};
	};
};

&ubi_factory {
	nvmem-layout {
		compatible = "fixed-layout";
		#address-cells = <1>;
		#size-cells = <1>;

		eeprom: eeprom@0 {
			reg = <0x0 0x1e00>;
		};

		wan_mac: macaddr@5000 {
			reg = <0x5000 0x6>;
		};

		lan_mac: macaddr@6000 {
			compatible = "mac-base";
			reg = <0x6000 0x6>;
			#nvmem-cell-cells = <1>;
		};
	};
};

&i2c0 {
	status = "okay";

	hwmon@2e {
		compatible = "nuvoton,nct7802";
		reg = <0x2e>;
	};
};

&afe {
	status = "disabled";
};

&eth {
	status = "okay";

		/* GDM3 is fed by the XSI arbiter from the two free PCIe SerDes
		 * lanes (no WiFi on the XG2010G).  nbq 4 -> PCIe0 SerDes,
		 * nbq 5 -> PCIe1 SerDes.  Vendor firmware assigns phy8 (LAN2,
		 * RTL8261N) to PCIe1 (links at 10G with a 10G partner) and
		 * en8811 (LAN3, EN8811HN) to PCIe0. */
		gdm3: ethernet@3 {
			compatible = "airoha,eth-mac";
			reg = <3>;
			status = "okay";

			#address-cells = <1>;
			#size-cells = <0>;

			lan3_port: eth-port@4 {
				compatible = "airoha,eth-port";
				reg = <4>;

				phy-handle = <&en8811>;
				phy-mode = "2500base-x";
				pcs-handle = <&pcie_pcs 0>;

				nvmem-cells = <&lan_mac 2>;
				nvmem-cell-names = "mac-address";
				openwrt,netdev-name = "lan3";
			};

			lan2_port: eth-port@5 {
				compatible = "airoha,eth-port";
				reg = <5>;

				managed = "in-band-status";
				phy-handle = <&phy8>;
				phy-mode = "usxgmii";
				pcs-handle = <&pcie_pcs 1>;

				nvmem-cells = <&lan_mac 1>;
				nvmem-cell-names = "mac-address";
				openwrt,netdev-name = "lan2";
			};
		};
};

&pon_pcs {
	status = "okay";
};

&gdm1 {
	status = "okay";

	nvmem-cells = <&lan_mac 0>;
	nvmem-cell-names = "mac-address";
};

&gdm2 {
	status = "okay";

	managed = "in-band-status";
	/* XGSPON via upstream pon_pcs; optical PHY is EN7573AN.
	 * 10gbase-r vs usxgmii depends on EN7573AN SerDes mode. */
	phy-mode = "10gbase-r";

	nvmem-cells = <&wan_mac 0>;
	nvmem-cell-names = "mac-address";
	openwrt,netdev-name = "wan";
};

&eth_pcs {
	status = "okay";
};

/* The two on-board PCIe SerDes lanes are free (no WiFi on the XG2010G),
 * so they are repurposed as Ethernet SerDes via the pcie_pcs provider and
 * the XSI arbiter to feed GDM3 (lan2/lan3 below).  The standalone PCIe PHY
 * driver is disabled: it exclusively claims the same PMA register region as
 * pcie_pcs (pcs_ana/pcs_pma0/pcs_pma1) and only does PCIe-specific analog
 * calibration, which would make pcie_pcs probe fail with -EBUSY.  The
 * airoha-pcs driver performs the ethernet SerDes PLL bringup itself. */
&pciephy {
	status = "disabled";
};

&pcie_pcs {
	status = "okay";
};

&gdm4 {
	status = "okay";
	airoha,lan-port;

	managed = "in-band-status";
	/* Confirmed: phy5 = 1st RTL8261BE (10G copper) on panel LAN1.
	 * Verified by link-up/RX packet tests; reset-gpios matches the
	 * vendor's decompiled dtb. */
	phy-handle = <&phy5>;
	phy-mode = "usxgmii";

	nvmem-cells = <&lan_mac 0>;
	nvmem-cell-names = "mac-address";
	openwrt,netdev-name = "lan1";
};

&switch {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;

	mdio {
		/* 1st RTL8261BE (10G copper); bound to gdm4 above as lan1. */
		phy5: ethernet-phy@5 {
			compatible = "ethernet-phy-ieee802.3-c45";
			reg = <5>;
			reset-gpios = <&en7581_pinctrl 29 GPIO_ACTIVE_LOW>;
			reset-assert-us = <200000>;
			reset-deassert-us = <200000>;
			tx-polarity = <PHY_POL_INVERT>;
			rx-polarity = <PHY_POL_INVERT>;
		};

		/* LAN2: 2nd RTL8261BE (10G copper).  Wired to GDM3 via the XSI
		 * arbiter on the PCIe0 SerDes lane (see gdm3/eth-port@4). */
		phy8: ethernet-phy@8 {
			compatible = "ethernet-phy-ieee802.3-c45";
			reg = <8>;
			reset-gpios = <&en7581_pinctrl 27 GPIO_ACTIVE_LOW>;
			reset-assert-us = <200000>;
			reset-deassert-us = <200000>;
			tx-polarity = <PHY_POL_INVERT>;
			rx-polarity = <PHY_POL_INVERT>;
		};

		/* LAN3: EN8811HN (2.5G copper).  Wired to GDM3 via the XSI
		 * arbiter on the PCIe1 SerDes lane (see gdm3/eth-port@5). */
		en8811: ethernet-phy@f {
			compatible = "ethernet-phy-ieee802.3-c45";
			reg = <15>;
		};
	};
};

/* Physically confirmed by link testing: of the SoC's 4 on-die switch
 * ports/PHYs (gsw_port1-4 @ MDIO reg 9/10/11/12), only port 4 is wired to
 * a panel jack on this board (probe test: plugging a cable into panel
 * lan4 only brought up link on gsw_port4, at 1000Mb/s Full). gsw_port1-3
 * are left disabled (an7581.dtsi default) since nothing is connected to
 * them here - the vendor's decompiled fdt@1.dts phy@13/phy@14 entries
 * are a different, unrelated proprietary MDIO addressing scheme and do
 * not correspond to these on-die ports. */
&gsw_phy4 {
	status = "okay";
};

&gsw_port4 {
	status = "okay";
	label = "lan4";
};

&cpufreq {
	reg = <0x0 0x1FA20000 0x0 0x2C0
	       0x0 0x1EFBE000 0x0 0x800>;
	reg-names = "chip-scu", "mcucfg";
};

/* Enable the NPU for PPE offload.  No WiFi is present, so the generic
 * EN7581 NPU firmware is used. */
&npu {
	status = "okay";
	firmware-name = "airoha/en7581_npu_rv32.bin",
			"airoha/en7581_npu_data.bin";
};

&uart2 {
	status = "disabled";
};

&hsuart3 {
	status = "disabled";
};
